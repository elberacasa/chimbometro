# Get a key at https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Shared counters for rate limits and the daily spend cap (https://upstash.com, free tier is enough).
# Required in production: without them the API refuses to call Jev. Development falls back to memory.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Maximum Jev spend per UTC day before the API pauses until midnight. Default: 5 (≈ 33,000 offers).
DAILY_BUDGET_USD=5

# Authenticates the daily Vercel Cron call to /api/radar/refresh.
CRON_SECRET=
