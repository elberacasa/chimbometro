{
  "name": "chimbometro",
  "private": true,
  "description": "Pega una oferta de trabajo y mide qué tan chimba es. Hecho con Jev de TypeSafe.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "jev:check": "tsx --env-file=.env scripts/check-key.ts",
    "jev:eval": "tsx --env-file=.env scripts/eval-offers.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
